{
  "name": "cyber-companion-v3",
  "version": "0.1.0",
  "private": true,
  "description": "Intelligent Cybersecurity Awareness & Threat Intelligence System",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx,.js",
    "typecheck": "tsc --build --dry",
    "test": "jest --passWithNoTests",
    "build": "npm run build --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "start:api": "npm --workspace=@cyber-companion/api run start",
    "start:mobile": "npm --workspace=@cyber-companion/mobile run start"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "eslint": "^8.57.0",
    "hermes-compiler": "^250829098.0.19",
    "jest": "^29.7.0",
    "prettier": "^3.3.0",
    "ts-jest": "^29.1.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

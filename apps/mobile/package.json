{
  "name": "@cyber-companion/mobile",
  "version": "1.0.0",
  "description": "Cross-Platform React Native (Android, iOS) & Web Client",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "tunnel": "expo start --tunnel",
    "tunnel:free": "concurrently --names \"EXPO,TUNNEL\" -c \"cyan,green\" \"npx expo start -c\" \"npx cloudflared tunnel --url http://localhost:8081\"",
    "tunnel:cf": "npx cloudflared tunnel --url http://localhost:8081",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cyber-companion/scoring-core": "*",
    "@cyber-companion/shared-types": "*",
    "@expo/metro-runtime": "^57.0.16",
    "expo": "^57.0.0",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-paper": "^5.12.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-vector-icons": "^10.1.0",
    "react-native-web": "^0.21.4",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.4",
    "concurrently": "^10.0.6",
    "typescript": "^5.4.5"
  }
}

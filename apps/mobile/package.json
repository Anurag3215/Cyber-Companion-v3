{
  "name": "@cyber-companion/mobile",
  "version": "1.0.0",
  "description": "Cross-Platform React Native (Android, iOS) & Web Client",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "tunnel": "expo start --tunnel",
    "tunnel:free": "concurrently --names \"EXPO,TUNNEL\" -c \"cyan,green\" \"npx expo start -c\" \"npx cloudflared tunnel --url http://localhost:8081\"",
    "tunnel:cf": "npx cloudflared tunnel --url http://localhost:8081",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build:apk": "eas build -p android --profile preview",
    "build:aab": "eas build -p android --profile production",
    "build:ios": "eas build -p ios --profile production"
  },
  "dependencies": {
    "@cyber-companion/scoring-core": "*",
    "@cyber-companion/shared-types": "*",
    "@expo/metro-runtime": "~58.0.15",
    "@types/three": "^0.186.0",
    "expo": "^58.0.19",
    "expo-blur": "~58.0.5",
    "expo-camera": "~58.0.12",
    "expo-network": "~58.0.4",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-paper": "^5.12.3",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-vector-icons": "^10.1.0",
    "react-native-web": "^0.21.4",
    "three": "^0.186.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.3.0",
    "concurrently": "^10.0.6",
    "typescript": "~6.0.3"
  }
}

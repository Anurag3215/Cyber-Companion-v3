{
  "expo": {
    "name": "Cyber Companion",
    "slug": "cyber-companion",
    "version": "1.0.0",
    "scheme": "cybercompanion",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.cybercompanion.security",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Cyber Companion to scan and analyze QR codes securely."
      }
    },
    "android": {
      "package": "io.cybercompanion.security",
      "permissions": [
        "CAMERA",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "INTERNET",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0D1117"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Cyber Companion to scan and analyze QR codes securely."
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "d3089555-69e0-481e-8851-07c26b2051b3"
      }
    },
    "owner": "anuragts"
  }
}
